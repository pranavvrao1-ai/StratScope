# StratScope — environment variables (placeholders only; never commit real values)
# Copy to .env.local for local development, and set the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap, OG tags and email links.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase project (Settings → API). The anon key is safe to expose; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key: ONLY for local scripts (scripts/verify-migration.mjs --db).
# The application never uses it. Do NOT add it to Vercel and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Content source: "supabase" (default when Supabase is configured) or "seed"
# (read-only preview from src/lib/content/seed-data.json; admin and forms disabled).
CONTENT_SOURCE=

# Optional: show "Continue with Google" on /login (enable the Google provider in Supabase first).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Optional transactional email via Resend (welcome emails, new-article newsletters, contact notifications).
# Leave empty to disable email; all features still work.
RESEND_API_KEY=
EMAIL_FROM="StratScope <newsletter@your-domain.example>"
# Where contact-form notifications go (defaults to the address shown on the Contact page).
CONTACT_INBOX=
