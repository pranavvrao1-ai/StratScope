{
  "name": "stratscope",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "seed:build": "node scripts/build-seed.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "verify:migration:db": "node scripts/verify-migration.mjs --db",
    "verify:routes": "node scripts/verify-routes.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run verify:migration && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
